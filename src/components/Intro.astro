---
/**
 * Tela de intro (só na página inicial, uma vez por visita):
 * vídeo debaixo d'água + simulação de fluido que segue o cursor (src/scripts/intro-fluid.ts),
 * a gota da logo cai na água, "Bem-vindo à Droplab" aparece; o visitante entra pelo botão.
 *
 * Só aparece quando o script do <head> marca <html class="intro-on">: sem JavaScript,
 * para robôs de busca, ao voltar na mesma visita ou com link para uma seção (#), o site
 * abre direto. Para ver de novo na mesma aba: /?intro
 * Controle: src/scripts/intro.ts
 */
import LogoMark from './ui/LogoMark.astro';
import { site } from '@/config/site';
---

<div class="intro" data-intro role="dialog" aria-modal="true" aria-label="Boas-vindas da Droplab">
  <div class="intro-media" aria-hidden="true">
    <img
      class="intro-poster"
      src="/video/intro-poster.webp"
      alt=""
      decoding="async"
      data-intro-poster
    />
    <video
      class="intro-video"
      data-intro-video
      data-src="/video/intro.mp4"
      data-src-sm="/video/intro-sm.mp4"
      muted
      playsinline
      loop
      preload="none"
      tabindex="-1"
    ></video>
    <canvas class="intro-canvas" data-intro-canvas></canvas>
  </div>
  <div class="intro-glow" aria-hidden="true"></div>
  <div class="intro-shade" aria-hidden="true"></div>

  <div class="intro-center">
    <p class="intro-hello">Bem-vindo à</p>
    <div class="intro-brand">
      <span class="intro-mark-wrap" data-intro-mark>
        <LogoMark class="intro-mark" />
        <span class="intro-ripple" aria-hidden="true"></span>
        <span class="intro-ripple intro-ripple-2" aria-hidden="true"></span>
      </span>
      <span class="intro-word" aria-label={site.name}>
        {'Drop'.split('').map((c, i) => (
          <span class="intro-ch" style={`--i:${i}`} aria-hidden="true">
            {c}
          </span>
        ))}
        {'lab'.split('').map((c, i) => (
          <span class="intro-ch intro-ch-blue" style={`--i:${i + 4}`} aria-hidden="true">
            {c}
          </span>
        ))}
      </span>
    </div>
    <p class="intro-slogan">{site.slogan}</p>
  </div>

  <div class="intro-foot">
    <p class="intro-hint" aria-hidden="true">
      <span class="intro-hint-fine">Mova o cursor pela água</span>
      <span class="intro-hint-touch">Toque e arraste na água</span>
    </p>
    <button type="button" class="intro-enter" data-intro-enter>
      <span>Entrar no site</span>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path
          d="M5 12h14m-6-6 6 6-6 6"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </button>
  </div>
</div>

<style is:global>
  /* ---------- visibilidade e trava de rolagem ---------- */
  .intro {
    display: none;
  }
  html.intro-on {
    overflow: hidden;
  }
  html.intro-on .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #05070d;
    color: #f2f5fa;
    overflow: hidden;
    touch-action: none;
    cursor: default;
  }
  /* O hero espera a intro sair para fazer a entrada dele */
  html.intro-hold [data-hero-in] {
    animation-play-state: paused !important;
  }

  /* ---------- mídia ---------- */
  .intro-media,
  .intro-media > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro-media > img,
  .intro-media > video {
    object-fit: cover;
  }
  .intro-media {
    animation: intro-surface 2.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .intro-canvas {
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .intro-canvas.is-on {
    opacity: 1;
  }
  @keyframes intro-surface {
    from {
      opacity: 0;
      transform: scale(1.14);
    }
  }

  /* Luz que segue o cursor (aparelhos mais simples, sem a simulação) */
  .intro-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms ease;
    background: radial-gradient(
      34rem circle at var(--mx, 50%) var(--my, 50%),
      rgb(120 200 255 / 0.22),
      transparent 60%
    );
    mix-blend-mode: screen;
  }
  .intro.is-lite .intro-glow {
    opacity: 1;
  }

  /* Mesma camada escura da página: o vídeo é claro, o texto precisa de chão */
  .intro-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 50%,
        rgb(5 7 13 / 0.62) 0%,
        rgb(5 7 13 / 0.42) 55%,
        rgb(5 7 13 / 0.25) 100%
      ),
      linear-gradient(to bottom, rgb(5 7 13 / 0.6) 0%, rgb(5 7 13 / 0) 26%),
      linear-gradient(to top, rgb(5 7 13 / 0.9) 0%, rgb(5 7 13 / 0) 34%);
  }

  /* ---------- centro: Bem-vindo + logo ---------- */
  .intro-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    padding: 0 1.25rem 4rem;
    pointer-events: none;
    text-align: center;
  }
  .intro-hello {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgb(242 245 250 / 0.78);
    padding-left: 0.42em;
    animation: intro-hello 1.6s cubic-bezier(0.16, 1, 0.3, 1) 2.15s both;
  }
  @keyframes intro-hello {
    from {
      opacity: 0;
      letter-spacing: 0.9em;
      filter: blur(6px);
    }
  }
  .intro-brand {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2vw, 1.2rem);
  }
  .intro-mark-wrap {
    position: relative;
    display: block;
    width: clamp(3.6rem, 9vw, 6rem);
    aspect-ratio: 1;
  }
  .intro-mark {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 10px 40px rgb(10 108 255 / 0.45));
  }
  /* O "D" sobe da água... */
  .intro-mark use,
  .intro-mark path[stroke] {
    animation: intro-d 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
  }
  @keyframes intro-d {
    from {
      opacity: 0;
      transform: translateY(18%);
    }
  }
  /* ...e a gota cai dentro dele */
  .intro-mark .logo-drop {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: intro-drop 1.05s cubic-bezier(0.55, 0, 0.3, 1) 0.75s both;
  }
  @keyframes intro-drop {
    0% {
      opacity: 0;
      transform: translateY(-260%) scale(0.7, 1.25);
    }
    15% {
      opacity: 1;
    }
    68% {
      transform: translateY(0) scale(0.8, 1.15);
    }
    80% {
      transform: translateY(0) scale(1.18, 0.82);
    }
    100% {
      transform: none;
    }
  }
  /* Ondas onde a gota cai */
  .intro-ripple {
    position: absolute;
    left: 53.5%;
    top: 68%;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid rgb(120 200 255 / 0.7);
    border-radius: 50%;
    translate: -50% -50%;
    opacity: 0;
    animation: intro-ripple 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.45s both;
  }
  .intro-ripple-2 {
    animation-delay: 1.65s;
  }
  @keyframes intro-ripple {
    0% {
      opacity: 0.9;
      scale: 0.15;
    }
    100% {
      opacity: 0;
      scale: 4.2;
    }
  }
  .intro-word {
    display: inline-flex;
    overflow: hidden;
    padding: 0.06em 0.04em 0.14em;
    font-size: clamp(3rem, 1.4rem + 7vw, 6.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .intro-ch {
    display: inline-block;
    animation: intro-ch 1.1s cubic-bezier(0.16, 1, 0.3, 1) calc(1.5s + var(--i) * 55ms) both;
  }
  .intro-ch-blue {
    color: #2f86ff;
  }
  @keyframes intro-ch {
    from {
      transform: translateY(110%);
    }
  }
  .intro-slogan {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 245 250 / 0.55);
    text-wrap: balance;
    animation: intro-fade 1.2s ease 2.6s both;
  }
  @keyframes intro-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* ---------- rodapé: dica + Entrar ---------- */
  .intro-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(1.75rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 0 1.25rem;
    animation: intro-fade 1.2s ease 2.9s both;
  }
  .intro-hint {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(242 245 250 / 0.5);
  }
  .intro-hint-touch {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .intro-hint-fine {
      display: none;
    }
    .intro-hint-touch {
      display: inline;
    }
  }
  .intro-enter {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    overflow: hidden;
    padding: 0.85rem 1.4rem;
    border: 1px solid rgb(242 245 250 / 0.3);
    border-radius: 6px;
    background: rgb(5 7 13 / 0.25);
    backdrop-filter: blur(8px);
    color: #f2f5fa;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 300ms ease,
      background-color 300ms ease;
  }
  .intro-enter:hover {
    border-color: rgb(242 245 250 / 0.7);
    background: rgb(10 108 255 / 0.25);
  }
  .intro-enter:focus-visible {
    outline: 2px solid #2f86ff;
    outline-offset: 3px;
  }
  .intro-enter svg {
    transition: transform 300ms ease;
  }
  .intro-enter:hover svg {
    transform: translateX(3px);
  }
  /* ---------- saída: o conteúdo some e a tela sobe como uma onda ---------- */
  .intro.is-out .intro-center,
  .intro.is-out .intro-foot {
    animation: intro-content-out 600ms cubic-bezier(0.7, 0, 0.84, 0) both;
  }
  .intro.is-out {
    animation: intro-out 1.15s cubic-bezier(0.76, 0, 0.24, 1) 0.35s both;
  }
  @keyframes intro-content-out {
    to {
      opacity: 0;
      transform: translateY(-24px) scale(1.04);
      filter: blur(6px);
    }
  }
  @keyframes intro-out {
    to {
      clip-path: inset(0 0 100% 0);
    }
  }

  /* Movimento reduzido: a intro é curta e pode ser pulada; só o zoom grande do vídeo
     e a cortina viram fades (os movimentos pequenos da logo ficam, como no resto do site) */
  @media (prefers-reduced-motion: reduce) {
    .intro-media {
      animation-name: intro-fade-only;
    }
    .intro.is-out {
      animation: intro-fade-out 800ms ease 0.3s both;
    }
  }
  @keyframes intro-fade-only {
    from {
      opacity: 0;
    }
  }
  @keyframes intro-fade-out {
    to {
      opacity: 0;
    }
  }
</style>
