---
/**
 * Formatos de projeto, sem valores: cada proposta é feita sob medida.
 * O botão pré-seleciona o "Tipo de projeto" no formulário (src/scripts/form.ts).
 */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { plans } from '@/data/plans';
---

<Section id="planos" at={0.68}>
  <SectionHeading
    id="planos-title"
    title="Escolha o ponto de partida. O resto, a gente desenha com você."
    description="Cada proposta é personalizada depois de entendermos o seu projeto. O orçamento é gratuito e sem compromisso."
  />

  <ul class="grid gap-5 lg:grid-cols-3 lg:gap-6">
    {plans.map((plan, i) => (
      <li data-reveal data-reveal-delay={i * 100} class="relative">
        <article
          class:list={[
            'plan relative flex h-full flex-col overflow-hidden rounded-[10px] border p-7 sm:p-9',
            plan.highlighted ? 'is-lit border-brand/60 bg-surface' : 'border-line bg-surface/40',
          ]}
        >
          {plan.highlighted && <div class="plan-light" aria-hidden="true"></div>}
          <div class="relative flex items-start justify-between gap-4">
            <h3 class="text-[1.75rem] leading-tight tracking-[-0.035em]">{plan.name}</h3>
            {plan.highlighted && (
              <span class="mt-1.5 shrink-0 rounded-[4px] bg-brand px-2 py-1 text-measure text-[0.62rem]! text-white">
                Recomendado
              </span>
            )}
          </div>
          <p class="relative mt-3 text-body lg:min-h-[4.8em]">{plan.description}</p>
          <p class="relative mt-8 flex items-center gap-3 text-measure text-muted">
            <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
            {plan.timeline}
          </p>
          <ul class="relative mt-6 flex-1 space-y-3 border-t border-line pt-6">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-[0.95rem] text-body">
                <Icon
                  name="check"
                  size={16}
                  strokeWidth={2}
                  class="mt-1 shrink-0 text-accent-text"
                />
                {feature}
              </li>
            ))}
          </ul>
          <Button
            href="#contato"
            variant={plan.highlighted ? 'primary' : 'secondary'}
            arrow
            class="relative mt-9 w-full justify-between"
            data-project-type={plan.projectType}
            aria-label={`Pedir proposta: ${plan.name}`}
          >
            Pedir proposta
          </Button>
        </article>
      </li>
    ))}
  </ul>
</Section>

<style>
  .plan-light {
    position: absolute;
    inset: -40% -30% auto auto;
    width: 90%;
    height: 120%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--beam-a) 40%,
      var(--beam-b) 55%,
      transparent
    );
    transform: rotate(28deg);
    filter: blur(40px);
    opacity: 0.8;
    pointer-events: none;
  }
  .plan.is-lit {
    box-shadow: 0 30px 70px -40px rgb(10 108 255 / 0.7);
  }
</style>
