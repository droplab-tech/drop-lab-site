---
/**
 * "Estratégia + Experiência": os quatro pilares do trabalho, em cartões com foto.
 * Os cartões alternam foto em cima / foto embaixo e entram deslizando com uma
 * leve inclinação conforme a rolagem (src/scripts/motion.ts → initPillars).
 * Imagens geradas no Higgsfield (Nano Banana 2) para combinar com a luz do site.
 */
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import design from '@/assets/pillars/design.png';
import dev from '@/assets/pillars/dev.png';
import content from '@/assets/pillars/content.png';
import support from '@/assets/pillars/support.png';

const pillars = [
  {
    title: 'Design',
    text: 'Layouts criados do zero para a identidade da sua marca, pensados para guiar o olhar até o contato.',
    image: design,
    alt: 'Mesa de trabalho à noite com um monitor exibindo o layout de um site e um caderno de esboços',
    href: '#servicos',
    link: 'Ver serviços',
  },
  {
    title: 'Desenvolvimento',
    text: 'Código leve, rápido e responsivo, otimizado para o Google e para qualquer conexão.',
    image: dev,
    alt: 'Notebook em uma sala escura com linhas de código iluminadas na tela',
    href: '#entregas',
    link: 'O que vem incluso',
  },
  {
    title: 'Conteúdo',
    text: 'Textos e chamadas que explicam o seu negócio em segundos e levam o visitante à conversa.',
    image: content,
    alt: 'Caderno com rascunhos de wireframes e títulos ao lado de um celular com uma página aberta',
    href: '#diferenciais',
    link: 'Ver a diferença',
  },
  {
    title: 'Suporte',
    text: 'Acompanhamos o lançamento e seguimos ajustando o site com você depois da entrega.',
    image: support,
    alt: 'Celular em um suporte sobre a mesa exibindo uma conversa, com uma planta e uma luminária ao fundo',
    href: '#contato',
    link: 'Falar com a gente',
  },
];
---

<Section id="pilares" at={0.02} class="overflow-x-clip">
  <header class="mx-auto mb-14 max-w-2xl text-center sm:mb-20" data-reveal>
    <h2 id="pilares-title" class="text-title">
      Estratégia + Experiência
    </h2>
    <p class="mx-auto mt-5 max-w-lg text-[1.0625rem] leading-relaxed text-body">
      Desenhamos, desenvolvemos, escrevemos e acompanhamos sites que fazem o cliente confiar e agir.
    </p>
  </header>

  <ul class="pillars grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5" data-pillars>
    {pillars.map((p, i) => {
      const imageFirst = i % 2 === 0;
      return (
        <li class:list={['pillar-slot', !imageFirst && 'lg:pt-10']}>
          <article
            class="pillar group flex h-full flex-col rounded-[10px] border border-line bg-surface p-2 shadow-[0_30px_60px_-40px_rgb(0_0_0/0.9)]"
            data-pillar
          >
            <div class:list={['overflow-hidden rounded-[6px]', !imageFirst && 'lg:order-2']}>
              <Image
                src={p.image}
                alt={p.alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw"
                format="webp"
                quality={78}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-[1200ms] ease-out-soft group-hover:scale-[1.04]"
              />
            </div>
            <div
              class:list={[
                'flex flex-1 flex-col px-4 pt-5 pb-4',
                !imageFirst && 'lg:order-1 lg:pt-4 lg:pb-5',
              ]}
            >
              <h3 class="text-[1.5rem] leading-tight tracking-[-0.03em]">{p.title}</h3>
              <p class="mt-2.5 text-[0.95rem] leading-relaxed text-body">{p.text}</p>
              <a
                href={p.href}
                class="mt-auto inline-flex items-center gap-2.5 pt-5 text-[0.9rem] text-heading transition-colors hover:text-accent-text"
              >
                {p.link}
                <span class="grid h-6 w-6 place-items-center rounded-[4px] bg-heading/[0.07]">
                  <Icon
                    name="arrowUpRight"
                    size={13}
                    strokeWidth={2}
                    class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </a>
            </div>
          </article>
        </li>
      );
    })}
  </ul>
</Section>
