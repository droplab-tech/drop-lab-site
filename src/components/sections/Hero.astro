---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Drop from '../ui/Drop.astro';
import BrowserMockup from '../ui/BrowserMockup.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { site, whatsappLink } from '@/config/site';
---

<section
  id="inicio"
  aria-labelledby="inicio-title"
  class="relative isolate overflow-hidden pt-32 pb-16 sm:pt-40 lg:pt-44 lg:pb-24"
>
  <!-- Fundo: grade com máscara radial + brilhos da marca -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="bg-grid absolute inset-0 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_30%,#000_30%,transparent_80%)]"></div>
    <div class="absolute -top-40 left-1/2 h-[38rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,var(--glow),transparent)]"></div>
    <div class="absolute top-1/3 -right-40 h-[28rem] w-[28rem] rounded-full bg-[radial-gradient(closest-side,var(--glow-2),transparent)]"></div>
  </div>

  <div class="container-site grid items-center gap-16 lg:grid-cols-[1.08fr_1fr] lg:gap-10">
    <!-- Texto -->
    <div class="max-w-2xl">
      <p
        class="glass inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-xs font-medium text-body sm:text-sm"
        data-reveal
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-cyan opacity-30"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan"></span>
        </span>
        <span data-only="dark">{site.themeCopy.dark.heroBadge}</span>
        <span data-only="light">{site.themeCopy.light.heroBadge}</span>
      </p>

      <h1
        id="inicio-title"
        class="mt-7 text-[2.35rem] leading-[1.08] sm:text-5xl lg:text-[3.6rem] xl:text-[4rem]"
        data-reveal
        data-reveal-delay="80"
      >
        {site.copy.heroTitle}
        <span class="text-gradient">{site.copy.heroHighlight}</span>
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-body sm:text-xl"
        data-reveal
        data-reveal-delay="160"
      >
        {site.copy.heroSubtitle}
      </p>

      <div
        class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
        data-reveal
        data-reveal-delay="240"
      >
        <Button href="#contato" size="lg">
          Solicitar orçamento
          <Icon
            name="arrowRight"
            size={18}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </Button>
        <Button
          href={whatsappLink()}
          external
          size="lg"
          variant="secondary"
          data-track-location="hero"
        >
          <WhatsAppIcon class="h-5 w-5 text-[#25D366]" />
          Falar no WhatsApp
        </Button>
      </div>
    </div>

    <!-- Visual: gota com glow + mockup de navegador e celular em CSS -->
    <div
      class="relative mx-auto w-full max-w-[34rem] lg:max-w-none"
      aria-hidden="true"
      data-reveal
      data-reveal-delay="200"
    >
      <BrowserMockup animated />

      <!-- Notificação flutuante -->
      <div class="glass absolute -bottom-6 bg-surface/95! -left-3 flex animate-float items-center gap-3 rounded-2xl px-4 py-3 [animation-delay:-2s] sm:-left-8">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-[#25D366] text-white">
          <WhatsAppIcon class="h-5 w-5" />
        </span>
        <span class="text-left">
          <span class="block text-xs font-semibold text-heading">Nova mensagem</span>
          <span class="block text-xs text-body">"Quero um orçamento!"</span>
        </span>
      </div>

      <!-- Chip de responsividade -->
      <div class="glass absolute -top-5 bg-surface/95! -right-2 flex items-center gap-2 rounded-full px-3.5 py-2 text-xs font-medium text-heading sm:-right-6">
        <Icon name="sparkles" size={14} class="text-eyebrow" />
        Mobile-first
      </div>
    </div>
  </div>

  <!-- Faixa de prova -->
  <div class="container-site mt-20 lg:mt-24" data-reveal>
    <ul class="glass flex flex-col items-center justify-center gap-4 rounded-2xl px-6 py-5 text-sm font-medium text-heading sm:flex-row sm:gap-0 sm:divide-x sm:divide-line">
      {site.copy.proofStrip.map((item) => (
        <li class="flex items-center gap-2.5 sm:px-8">
          <Drop class="h-3.5 w-3" />
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
