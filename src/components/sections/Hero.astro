---
/**
 * Hero com vídeo em tela cheia (public/video/hero.mp4), no padrão da referência:
 * título no alto à esquerda, ações embaixo à direita, régua com as três marcas.
 * O loop é emendado com duas cópias do vídeo que se cruzam (ver src/scripts/hero-video.ts),
 * então a virada do fim para o começo não "pula".
 */
import Button from '../ui/Button.astro';
import { site, whatsappLink } from '@/config/site';

const poster = '/video/hero-poster.webp';
const src = '/video/hero.mp4';
---

<section
  id="inicio"
  aria-labelledby="inicio-title"
  class="relative isolate flex min-h-[max(100svh,40rem)] flex-col overflow-hidden pt-[4.25rem]"
>
  <!-- Vídeo de fundo -->
  <div class="absolute inset-0 -z-10 bg-ink" data-hero-media>
    <div class="hero-video absolute inset-0" data-hero-video>
      <video
        class="absolute inset-0 h-full w-full object-cover"
        src={src}
        poster={poster}
        muted
        playsinline
        autoplay
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
        data-layer="a"
      ></video>
      <video
        class="absolute inset-0 h-full w-full object-cover opacity-0"
        src={src}
        muted
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        data-layer="b"
      ></video>
    </div>
  </div>

  <!-- Escurecimento para leitura: mais forte à esquerda e na base -->
  <div class="hero-shade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-site relative flex flex-1 flex-col pt-[9vh] pb-8 sm:pt-[12vh] lg:pt-[14vh]">
    <div data-hero-copy>
      <h1 id="inicio-title" class="text-display max-w-[12ch] !text-snow">
        {site.copy.heroTitle}
      </h1>
      <p
        class="mt-7 max-w-[34rem] text-[1.0625rem] leading-relaxed text-snow/75 sm:text-lg"
        data-reveal
        data-reveal-delay="120"
      >
        {site.copy.heroSubtitle}
      </p>
    </div>

    <!-- Base: marcas à esquerda, ações à direita (como na referência) -->
    <div class="mt-auto pt-14" data-reveal data-reveal-delay="260">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <ul class="order-2 grid gap-3 sm:grid-cols-3 sm:gap-8 lg:order-1 lg:flex lg:gap-10">
          {site.copy.proofStrip.map((item, i) => (
            <li class="flex items-center gap-3 text-[0.95rem] text-snow">
              <span class:list={['h-3 w-px', i === 0 ? 'bg-cyan' : 'bg-brand']} aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
        <div class="order-1 flex flex-col gap-3 sm:flex-row sm:items-center lg:order-2">
          <Button
            href={whatsappLink()}
            external
            size="lg"
            arrow
            class="justify-between sm:justify-center"
            data-track-location="hero"
          >
            Fale no WhatsApp
          </Button>
          <Button href="#processo" size="lg" variant="secondary" class="hero-ghost">
            Ver como trabalhamos
          </Button>
        </div>
      </div>
      <div class="mt-6 flex items-center gap-4">
        <div class="ruler ruler-snow h-3 flex-1" aria-hidden="true"></div>
        <button
          type="button"
          class="grid h-8 w-8 shrink-0 place-items-center rounded-[4px] border border-snow/25 text-snow/80 transition-colors hover:border-snow/60 hover:text-snow"
          data-video-toggle
          aria-label="Pausar vídeo de fundo"
        >
          <svg data-icon="pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
          <svg data-icon="play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" class="hidden"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* O vídeo é sempre escuro: o hero fica escuro nos dois temas, como uma sala de cinema */
  .hero-shade {
    background:
      linear-gradient(90deg, rgb(5 7 13 / 0.82) 0%, rgb(5 7 13 / 0.45) 45%, rgb(5 7 13 / 0) 75%),
      linear-gradient(to bottom, rgb(5 7 13 / 0.55) 0%, rgb(5 7 13 / 0) 22%),
      linear-gradient(to top, rgb(5 7 13 / 0.85) 0%, rgb(5 7 13 / 0) 30%);
  }
  @media (max-width: 1023px) {
    .hero-shade {
      background:
        linear-gradient(to bottom, rgb(5 7 13 / 0.7) 0%, rgb(5 7 13 / 0.35) 55%, rgb(5 7 13 / 0.2) 70%),
        linear-gradient(to top, rgb(5 7 13 / 0.85) 0%, rgb(5 7 13 / 0) 35%);
    }
  }
  .hero-video video {
    transition: opacity 1200ms ease;
  }
  /* Entrada: o vídeo acende devagar */
  :global(.motion) .hero-video {
    animation: video-in 2200ms var(--ease-out-expo) both;
  }
  @keyframes video-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }
  .ruler-snow {
    --tick: rgb(242 245 250 / 0.22);
    --tick-strong: rgb(242 245 250 / 0.45);
  }
  /* Botão secundário sobre o vídeo: sempre claro, nos dois temas */
  #inicio :global(.hero-ghost) {
    color: #f2f5fa;
    border-color: rgb(242 245 250 / 0.3);
    backdrop-filter: blur(6px);
  }
  #inicio :global(.hero-ghost:hover) {
    border-color: rgb(242 245 250 / 0.7);
    background: rgb(242 245 250 / 0.06);
  }
</style>
