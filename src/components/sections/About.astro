---
/**
 * SOBRE: textos fáceis de editar logo abaixo.
 * ⚠️ PLACEHOLDER: troque `founder` pelo nome de quem está por trás da Droplab, se quiser.
 */
import Section from '../ui/Section.astro';

const founder = {
  name: 'Equipe Droplab', // ⚠️ PLACEHOLDER: ex.: "Seu Nome, fundador"
  role: 'Design & Desenvolvimento Web',
};

const paragraphs = [
  'A Droplab cria sites profissionais e páginas de conversão sob medida para empresas e profissionais que querem ser encontrados no Google, transmitir confiança e transformar visitas em contatos.',
  'Unimos design, tecnologia e estratégia de conversão em um processo simples: você conversa direto com quem desenvolve, acompanha cada etapa e recebe um site rápido, bonito e pronto para gerar resultado.',
];

const mission =
  'Ajudar negócios a crescer no digital com sites que unem estética, performance e resultado.';
---

<Section id="sobre" at={0.8}>
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7" data-reveal>
      <h2 id="sobre-title" class="text-title max-w-[16ch]">
        Um estúdio pequeno de propósito. Você fala com quem faz.
      </h2>
      <p class="mt-10 flex items-center gap-4 text-sm text-muted">
        <span class="h-px w-10 bg-brand" aria-hidden="true"></span>
        <span>
          <span class="text-heading">{founder.name}</span> · {founder.role}
        </span>
      </p>
    </div>
    <div
      class="space-y-5 text-[1.0625rem] leading-relaxed text-body lg:col-span-4 lg:col-start-9"
      data-reveal
      data-reveal-delay="120"
    >
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      <p class="border-t border-line pt-5 text-heading">
        <span class="sr-only">Nossa missão: </span>
        {mission}
      </p>
    </div>
  </div>
</Section>
