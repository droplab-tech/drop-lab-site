---
/**
 * SOBRE: textos fáceis de editar logo abaixo.
 * ⚠️ PLACEHOLDER: troque `founder` pelo nome de quem está por trás da Droplab, se quiser.
 */
import Section from '../ui/Section.astro';
import Drop from '../ui/Drop.astro';
import LogoMark from '../ui/LogoMark.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

const founder = {
  name: 'Equipe Droplab', // ⚠️ PLACEHOLDER: ex.: "Seu Nome, fundador"
  role: 'Design & Desenvolvimento Web',
};

const paragraphs = [
  'A Droplab cria sites e landing pages sob medida para empresas e profissionais que querem ser encontrados no Google, transmitir confiança e transformar visitas em contatos.',
  'Unimos design, tecnologia e estratégia de conversão em um processo simples: você conversa direto com quem desenvolve, acompanha cada etapa e recebe um site rápido, bonito e pronto para gerar resultado.',
];

const mission =
  'Ajudar negócios a crescer no digital com sites que unem estética, performance e resultado.';

/** Nosso compromisso: como trabalhamos em todo projeto */
const commitments: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'message',
    title: 'Atendimento direto',
    text: 'Você fala com quem desenvolve o seu projeto, sem intermediários.',
  },
  {
    icon: 'clock',
    title: 'Prazos claros',
    text: 'Cronograma definido na proposta e atualizações a cada etapa.',
  },
  {
    icon: 'eye',
    title: 'Orçamento transparente',
    text: 'Escopo e investimento por escrito, sem custos escondidos.',
  },
  {
    icon: 'sparkles',
    title: 'Atenção aos detalhes',
    text: 'Cuidado com cada pixel e cada linha de código.',
  },
];
---

<Section id="sobre" tone="alt">
  <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <!-- Visual -->
    <div class="relative order-last lg:order-first" data-reveal>
      <div class="glass relative mx-auto aspect-square max-w-md overflow-hidden rounded-[2rem]">
        <div class="bg-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,var(--glow),transparent_60%)]"
          aria-hidden="true"
        ></div>
        <!-- Ondas concêntricas: a gota que gera movimento -->
        <div class="absolute inset-0 grid place-items-center" aria-hidden="true">
          {[1, 2, 3].map((n) => (
            <span
              class="absolute rounded-full border border-cyan/20"
              style={`width:${30 + n * 20}%;height:${30 + n * 20}%;`}
            />
          ))}
          <LogoMark class="relative h-[34%] w-[34%] drop-shadow-[0_20px_40px_rgb(10_108_255/0.5)]" />
        </div>
        <div class="glass absolute inset-x-5 bottom-5 rounded-2xl p-4">
          <p class="font-display font-semibold text-heading">{founder.name}</p>
          <p class="text-sm text-body">{founder.role}</p>
        </div>
      </div>
    </div>

    <!-- Texto -->
    <div>
      <div data-reveal>
        <p class="eyebrow inline-flex items-center gap-2.5">
          <Drop class="h-3 w-2.5" /> Sobre
        </p>
        <h2 id="sobre-title" class="mt-4 text-3xl leading-tight sm:text-4xl lg:text-[2.75rem]">
          Como a Droplab <span class="text-gradient">trabalha com você</span>
        </h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-body">
          {paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <blockquote class="mt-8 rounded-2xl border-l-2 border-cyan bg-surface/60 p-5" data-reveal>
        <p class="text-xs font-semibold tracking-[0.2em] text-eyebrow uppercase">Nossa missão</p>
        <p class="mt-2 font-display text-lg font-medium text-heading">{mission}</p>
      </blockquote>

      <p class="eyebrow mt-10" data-reveal>
        Nosso compromisso
      </p>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {commitments.map((v, i) => (
          <li class="flex gap-3.5" data-reveal data-reveal-delay={i * 70}>
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-line bg-bg text-eyebrow">
              <Icon name={v.icon} size={18} />
            </span>
            <span>
              <span class="block font-display font-semibold text-heading">{v.title}</span>
              <span class="mt-0.5 block text-sm leading-relaxed text-body">{v.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
