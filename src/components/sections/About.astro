---
/**
 * SOBRE: textos fáceis de editar logo abaixo.
 * Fundo: o "D" da Droplab em 3D, com a gota no meio, no fundo do mar; o ambiente
 * (raios de luz, partículas, areia com cáusticas) gira em volta dele.
 * Cena em src/scripts/about-3d.ts (Three.js, carregada só quando a seção chega perto).
 * Sem WebGL ou em aparelho fraco: fica a versão estática (logo com brilho, em CSS).
 * ⚠️ PLACEHOLDER: troque `founder` pelo nome de quem está por trás da Droplab, se quiser.
 */
import Section from '../ui/Section.astro';
import LogoMark from '../ui/LogoMark.astro';

const founder = {
  name: 'Equipe Droplab', // ⚠️ PLACEHOLDER: ex.: "Seu Nome, fundador"
  role: 'Design & Desenvolvimento Web',
};

const paragraphs = [
  'A Droplab cria sites profissionais e páginas de conversão sob medida para empresas e profissionais que querem ser encontrados no Google, transmitir confiança e transformar visitas em contatos.',
  'Unimos design, tecnologia e estratégia de conversão em um processo simples: você conversa direto com quem desenvolve, acompanha cada etapa e recebe um site rápido, bonito e pronto para gerar resultado.',
];

const mission =
  'Ajudar negócios a crescer no digital com sites que unem estética, performance e resultado.';
---

<Section id="sobre" at={0.8} class="about-sea overflow-hidden bg-ink">
  <div class="grid gap-10 lg:min-h-[88svh] lg:grid-cols-12 lg:gap-10">
    <div class="relative z-10 lg:col-span-6" data-reveal>
      <h2 id="sobre-title" class="text-title max-w-[16ch]">
        Um estúdio pequeno de propósito. Você fala com quem faz.
      </h2>
      <p class="mt-10 flex items-center gap-4 text-sm text-muted">
        <span class="h-px w-10 bg-brand" aria-hidden="true"></span>
        <span>
          <span class="text-heading">{founder.name}</span> · {founder.role}
        </span>
      </p>
    </div>

    <!-- Cena 3D: fundo da seção inteira (celular e computador), atrás dos textos -->
    <div class="about-scene" data-about-3d aria-hidden="true">
      <div class="about-fallback">
        <LogoMark class="about-fallback-mark" />
      </div>
      <div class="about-shade"></div>
    </div>

    <!-- Celular: espaço entre o título e os parágrafos onde o "D" aparece -->
    <div class="about-spot" data-about-spot aria-hidden="true">
      <LogoMark class="about-fallback-mark" />
    </div>

    <div
      class="relative z-10 space-y-5 text-[1.0625rem] leading-relaxed text-body lg:col-span-4 lg:col-start-9 lg:self-end"
      data-reveal
      data-reveal-delay="120"
    >
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      <p class="border-t border-line pt-5 text-heading">
        <span class="sr-only">Nossa missão: </span>
        {mission}
      </p>
    </div>
  </div>
</Section>

<style>
  /* A seção é sempre "fundo do mar" (escura), nos dois temas, como o hero */
  :global(.about-sea) {
    --heading: #f2f5fa;
    --body: rgb(242 245 250 / 0.78);
    --muted: rgb(242 245 250 / 0.6);
    --border: rgb(242 245 250 / 0.16);
    --border-strong: rgb(242 245 250 / 0.32);
    --tick: rgb(242 245 250 / 0.22);
    --tick-strong: rgb(242 245 250 / 0.45);
    color: var(--body);
  }
  :global(.about-sea .ruler) {
    position: relative;
    z-index: 1;
  }

  .about-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 40% at 50% 0%, rgb(14 90 122 / 0.55), transparent 70%),
      linear-gradient(to bottom, #06233f, #020814);
  }
  /* Espaço do "D" no celular; a versão estática do logo fica nele até o 3D carregar */
  .about-spot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: min(58svh, 30rem);
    transition: opacity 1.2s ease;
  }
  @media (min-width: 1024px) {
    .about-spot {
      display: none;
    }
  }
  .about-spot :global(svg) {
    width: min(55%, 12rem);
  }
  :global(.about-sea:has(.is-3d)) .about-spot {
    opacity: 0;
  }
  .about-scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .about-scene :global(canvas.is-on) {
    opacity: 1;
  }

  /* Versão estática (sem WebGL / aparelho fraco / antes de carregar) */
  .about-fallback {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    transition: opacity 1.2s ease;
  }
  @media (min-width: 1024px) {
    .about-fallback {
      display: grid;
    }
  }
  .about-scene.is-3d .about-fallback {
    opacity: 0;
  }
  .about-fallback :global(svg) {
    width: min(38%, 15rem);
  }
  .about-fallback-mark {
    height: auto;
    filter: drop-shadow(0 0 60px rgb(34 211 238 / 0.35));
    animation: about-float 7s ease-in-out infinite;
  }
  @keyframes about-float {
    50% {
      transform: translateY(-10px) rotate(-2deg);
    }
  }

  /* Camada escura para leitura: mais forte onde está o texto (alto à esquerda, base à direita) */
  /* Celular: escuro atrás do título (alto) e dos parágrafos (base), claro no meio, onde
     está o "D" */
  .about-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(5 7 13 / 0.88) 0%,
      rgb(5 7 13 / 0.6) 17%,
      rgb(5 7 13 / 0) 27%,
      rgb(5 7 13 / 0) 50%,
      rgb(5 7 13 / 0.72) 60%,
      rgb(5 7 13 / 0.85) 100%
    );
  }
  @media (min-width: 1024px) {
    .about-shade {
      background:
        linear-gradient(100deg, rgb(5 7 13 / 0.78) 0%, rgb(5 7 13 / 0.2) 40%, rgb(5 7 13 / 0) 55%),
        linear-gradient(280deg, rgb(5 7 13 / 0.72) 0%, rgb(5 7 13 / 0.15) 32%, rgb(5 7 13 / 0) 45%),
        linear-gradient(to bottom, rgb(5 7 13 / 0.9) 0%, rgb(5 7 13 / 0) 14%),
        linear-gradient(to top, rgb(5 7 13 / 0.85) 0%, rgb(5 7 13 / 0) 18%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-fallback-mark {
      animation: none;
    }
  }
</style>
