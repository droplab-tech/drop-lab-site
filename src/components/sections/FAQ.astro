---
/** FAQ com <details>/<summary>: acessível por padrão e funciona sem JavaScript. */
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import { faq } from '@/data/faq';
import { whatsappLink } from '@/config/site';

// Dados estruturados FAQPage (podem gerar resultados ricos no Google)
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Section id="faq" at={0.88}>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <h2 id="faq-title" class="text-title">
        Perguntas frequentes
      </h2>
      <p class="mt-6 max-w-sm leading-relaxed text-body">
        Respostas diretas para as dúvidas mais comuns antes de começar.
      </p>
      <a
        href={whatsappLink('Olá! Tenho uma dúvida sobre os serviços da Droplab.')}
        target="_blank"
        rel="noopener noreferrer"
        data-track-location="faq"
        class="group mt-8 inline-flex items-center gap-2 text-heading underline decoration-line-strong underline-offset-[0.3em] transition-colors hover:decoration-brand"
      >
        Outra dúvida? Pergunte no WhatsApp
        <Icon
          name="arrowUpRight"
          size={16}
          class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>

    <div class="border-t border-line lg:col-span-7 lg:col-start-6">
      {faq.map((item) => (
        <details class="faq-item group border-b border-line" name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.15rem] font-medium tracking-[-0.02em] text-heading transition-colors hover:text-accent-text sm:text-[1.25rem]">
            {item.question}
            <span class="faq-icon grid h-8 w-8 shrink-0 place-items-center rounded-[4px] border border-line text-heading transition-[transform,border-color] duration-500">
              <Icon name="plus" size={16} strokeWidth={1.75} />
            </span>
          </summary>
          <div class="max-w-[62ch] pb-7 leading-relaxed text-body">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #0a6cff;
  }
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 450ms var(--ease-out-expo),
      content-visibility 450ms allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }
  }
</style>
