---
/** "O que você recebe": padrão de qualidade incluso em todo projeto (src/data/deliverables.ts). */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { deliverables } from '@/data/deliverables';
---

<Section id="entregas" at={0.56}>
  <SectionHeading
    id="entregas-title"
    title="O que já vem incluso em todo projeto."
    description="Um padrão de qualidade que não muda com o tamanho do projeto: seja uma landing page ou um site completo."
  />

  <dl class="grid border-t border-line md:grid-cols-2 md:gap-x-16">
    {deliverables.map((d, i) => (
      <div
        class="spec grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4 gap-y-1.5 border-b border-line py-7 sm:grid-cols-[2.5rem_14rem_minmax(0,1fr)] sm:items-baseline md:grid-cols-[2rem_minmax(0,1fr)] md:items-start xl:grid-cols-[2.5rem_12rem_minmax(0,1fr)] xl:items-baseline"
        data-reveal
        data-reveal-delay={(i % 2) * 80}
      >
        <Icon
          name={d.icon}
          size={20}
          strokeWidth={1.5}
          class="row-span-2 translate-y-1 text-accent-text sm:row-span-1 md:row-span-2 xl:row-span-1"
        />
        <dt class="text-[1.15rem] font-medium tracking-[-0.02em] text-heading">{d.title}</dt>
        <dd class="text-[0.95rem] leading-relaxed text-body">{d.description}</dd>
      </div>
    ))}
  </dl>
</Section>
