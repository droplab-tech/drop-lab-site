---
/** "O que você recebe": padrão de qualidade incluso em todo projeto (src/data/deliverables.ts). */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import BrowserMockup from '../ui/BrowserMockup.astro';
import { deliverables } from '@/data/deliverables';
---

<Section id="entregas" tone="alt">
  <SectionHeading
    id="entregas-title"
    eyebrow="Entregas"
    title="O que você recebe"
    highlight="em todo projeto"
    description="Um padrão de qualidade que já vem incluso, seja uma landing page ou um site completo."
  />

  <div class="grid items-center gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
    <!-- Visual: navegador + celular (ilustrativo) -->
    <div class="relative mx-auto w-full max-w-lg pb-10 lg:max-w-none" data-reveal>
      <BrowserMockup />
      <div
        class="absolute right-0 bottom-0 w-[34%] max-w-[10.5rem] rounded-[1.6rem] border border-line-strong bg-surface p-2 shadow-[0_20px_50px_-20px_rgb(0_0_0/0.6)] sm:-right-4"
        aria-hidden="true"
      >
        <div class="overflow-hidden rounded-[1.2rem] border border-line bg-bg">
          <div class="mx-auto mt-2 h-1.5 w-10 rounded-full bg-line-strong"></div>
          <div class="space-y-2 p-3">
            <div class="flex items-center gap-1.5">
              <span class="h-3 w-3 rounded bg-button-gradient"></span>
              <span class="h-1.5 w-8 rounded-full bg-heading/70"></span>
            </div>
            <span class="mt-3 block h-2 w-full rounded-full bg-heading/85"></span>
            <span class="block h-2 w-4/5 rounded-full bg-heading/85"></span>
            <span class="block h-1.5 w-full rounded-full bg-line-strong"></span>
            <span class="block h-1.5 w-2/3 rounded-full bg-line-strong"></span>
            <span class="mt-3 flex h-6 w-full items-center justify-center rounded-full bg-[#25D366]">
              <span class="h-1 w-10 rounded-full bg-white/90"></span>
            </span>
            <div class="grid grid-cols-2 gap-1.5 pt-1">
              <span class="h-8 rounded-md border border-line bg-surface"></span>
              <span class="h-8 rounded-md border border-line bg-surface"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lista de entregas -->
    <ul class="grid gap-4 sm:grid-cols-2">
      {deliverables.map((item, i) => (
        <li
          class="group glass flex gap-4 rounded-2xl p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-strong"
          data-reveal
          data-reveal-delay={(i % 2) * 80}
        >
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-line bg-bg-2 text-eyebrow transition-colors duration-300 group-hover:border-cyan/40">
            <Icon name={item.icon} size={20} />
          </span>
          <div>
            <h3 class="text-base">{item.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-body">{item.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-12 text-center" data-reveal>
    <Button href="#contato">
      Solicitar orçamento
      <Icon name="arrowRight" size={18} class="transition-transform group-hover:translate-x-1" />
    </Button>
  </div>
</Section>
