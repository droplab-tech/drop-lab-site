---
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import ContactForm from './ContactForm.astro';
import { site, whatsappLink } from '@/config/site';

// "@usuario" extraído do link do Instagram em site.ts (vazio = linha escondida)
const instagramHandle = site.social.instagram
  ? site.social.instagram.replace(/\/+$/, '').split('/').pop()
  : '';

const row =
  'group flex items-center gap-4 border-b border-line py-5 transition-colors hover:border-line-strong';
---

<Section id="contato" at={0.96}>
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5" data-reveal>
      <h2 id="contato-title" class="text-title max-w-[12ch]">
        Peça seu orçamento gratuito
      </h2>
      <p class="mt-6 max-w-md text-[1.0625rem] leading-relaxed text-body">
        Preencha o formulário ou chame direto no WhatsApp. Respondemos em horário comercial,
        normalmente no mesmo dia.
      </p>

      <ul class="mt-10 border-t border-line">
        <li>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener noreferrer"
            data-track-location="contato"
            class={row}
          >
            <WhatsAppIcon class="h-5 w-5 shrink-0 text-whatsapp" />
            <span class="flex-1">
              <span class="block text-sm text-muted">WhatsApp</span>
              <span class="block text-heading">{site.contact.whatsappDisplay}</span>
            </span>
            <Icon
              name="arrowUpRight"
              size={18}
              class="text-muted transition-[color,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-heading"
            />
          </a>
        </li>
        {site.contact.email && (
          <li>
            <a href={`mailto:${site.contact.email}`} class={row}>
              <Icon name="mail" size={20} strokeWidth={1.5} class="shrink-0 text-accent-text" />
              <span class="min-w-0 flex-1">
                <span class="block text-sm text-muted">E-mail</span>
                <span class="block break-all text-heading">{site.contact.email}</span>
              </span>
              <Icon
                name="arrowUpRight"
                size={18}
                class="text-muted transition-[color,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-heading"
              />
            </a>
          </li>
        )}
        {instagramHandle && (
          <li>
            <a
              href={site.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Instagram da ${site.name}`}
              class={row}
            >
              <Icon
                name="instagram"
                size={20}
                strokeWidth={1.5}
                class="shrink-0 text-accent-text"
              />
              <span class="flex-1">
                <span class="block text-sm text-muted">Instagram</span>
                <span class="block text-heading">@{instagramHandle}</span>
              </span>
              <Icon
                name="arrowUpRight"
                size={18}
                class="text-muted transition-[color,transform] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-heading"
              />
            </a>
          </li>
        )}
        <li class="flex items-center gap-4 border-b border-line py-5">
          <Icon name="clock" size={20} strokeWidth={1.5} class="shrink-0 text-accent-text" />
          <span>
            <span class="block text-sm text-muted">Atendimento</span>
            <span class="block text-heading">{site.contact.hours}</span>
            <span class="block text-sm text-body">
              {site.contact.city}, {site.contact.state} · Projetos para todo o Brasil
            </span>
          </span>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-7" data-reveal data-reveal-delay="120">
      <ContactForm />
    </div>
  </div>
</Section>
