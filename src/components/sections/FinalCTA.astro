---
import Button from '../ui/Button.astro';
import LightDrop from '../ui/LightDrop.astro';
import { site, whatsappLink } from '@/config/site';
---

<section aria-labelledby="cta-title" class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="beam opacity-80"></div>
  </div>
  <div class="container-site">
    <div class="ruler h-3" aria-hidden="true"></div>
    <div class="grid items-end gap-12 py-24 sm:py-32 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8" data-reveal>
        <h2 id="cta-title" class="cta-title max-w-[16ch]">
          {site.copy.finalCtaTitle}
        </h2>
        <p class="mt-7 max-w-lg text-lg leading-relaxed text-body">{site.copy.finalCtaText}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button
            href={whatsappLink()}
            external
            size="lg"
            arrow
            class="justify-between sm:justify-center"
            data-track-location="cta-final"
          >
            Chamar no WhatsApp
          </Button>
          <Button href="#contato" size="lg" variant="secondary">Preencher o formulário</Button>
        </div>
      </div>
      <div class="hidden justify-end pb-6 lg:col-span-4 lg:flex" data-reveal data-reveal-delay="150">
        <LightDrop class="h-56 xl:h-64" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-title {
    font-size: clamp(2.3rem, 1.3rem + 4vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
</style>
