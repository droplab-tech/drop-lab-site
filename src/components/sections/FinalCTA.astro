---
import Button from '../ui/Button.astro';
import LogoMark from '../ui/LogoMark.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { site, whatsappLink } from '@/config/site';
---

<section aria-labelledby="cta-title" class="relative py-10 sm:py-16">
  <div class="container-site">
    <div
      class="relative isolate overflow-hidden rounded-[2rem] bg-brand-gradient px-6 py-14 text-center sm:px-12 sm:py-20"
      data-reveal
    >
      <!-- Escurece levemente o degradê para garantir contraste AA do texto branco -->
      <div class="absolute inset-0 -z-10 bg-ink/45" aria-hidden="true"></div>
      <div
        class="bg-grid absolute inset-0 -z-10 opacity-60 [--grid-line:rgb(255_255_255/0.07)]"
        aria-hidden="true"
      ></div>
      <LogoMark class="pointer-events-none absolute -top-16 -right-16 -z-10 h-72 w-72 opacity-25 sm:h-96 sm:w-96" />

      <h2 id="cta-title" class="mx-auto max-w-3xl text-3xl leading-tight !text-white sm:text-5xl">
        {site.copy.finalCtaTitle}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/90">
        {site.copy.finalCtaText}
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button
          href={whatsappLink()}
          external
          size="lg"
          variant="light"
          data-track-location="cta-final"
        >
          <WhatsAppIcon class="h-5 w-5 text-[#128C7E]" />
          Chamar no WhatsApp
        </Button>
        <a
          href="#contato"
          class="inline-flex h-14 items-center rounded-full px-6 font-display font-semibold text-white underline-offset-4 hover:underline"
        >
          ou preencha o formulário
        </a>
      </div>
    </div>
  </div>
</section>
