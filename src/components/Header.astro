---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { navItems } from '@/config/navigation';
import { whatsappLink } from '@/config/site';

interface Props {
  /** Em páginas internas os links apontam para a home (/#secao) */
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const href = (anchor: string) => (isHome ? anchor : `/${anchor}`);
// "Início" fica no logo; o menu mostra só as seções
const menu = navItems.filter((item) => item.href !== '#inicio');
---

<header
  data-header
  data-over-hero={isHome ? 'true' : undefined}
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled=true]:border-line data-[scrolled=true]:bg-bg/80 data-[scrolled=true]:backdrop-blur-xl"
>
  <div class="container-site flex h-[4.25rem] items-center justify-between gap-6">
    <Logo href={isHome ? '#inicio' : '/'} />

    <nav aria-label="Navegação principal" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {menu.map((item) => (
          <li>
            <a
              href={href(item.href)}
              data-nav-link
              class="nav-link relative py-2 text-[0.9rem] text-body transition-colors duration-200 hover:text-heading aria-[current=true]:text-heading"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Rever a intro: discreto, só o ícone da gota com uma onda -->
      <a
        href="/?intro"
        class="intro-replay group relative grid h-10 w-10 shrink-0 place-items-center rounded-[6px] border border-transparent text-body transition-colors duration-300 hover:border-line hover:text-heading"
        aria-label="Rever a intro"
        title="Rever a intro"
        data-intro-replay
      >
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
          <path
            d="M12 3.5c2 2.6 5 6.1 5 8.9a5 5 0 0 1-10 0c0-2.8 3-6.3 5-8.9Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          ></path>
          <path
            d="M3 20.5c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            class="intro-replay-wave"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
      <div class="hidden sm:block">
        <Button
          href={whatsappLink()}
          external
          size="sm"
          arrow
          aria-label="Fale no WhatsApp (abre em nova aba)"
          data-track-location="header"
        >
          Fale no WhatsApp
        </Button>
      </div>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-[6px] border border-line text-heading transition-colors hover:border-line-strong lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-open
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<!-- Menu mobile: diálogo com foco preso, fecha com ESC ou clique fora -->
<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-[60] lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  hidden
>
  <div class="absolute inset-0 bg-ink/70 backdrop-blur-sm" data-menu-close></div>
  <div class="menu-panel absolute inset-y-0 right-0 flex w-full max-w-sm flex-col border-l border-line bg-bg px-6 pt-4 pb-8">
    <div class="flex items-center justify-between">
      <Logo href={isHome ? '#inicio' : '/'} />
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-[6px] border border-line text-heading hover:border-line-strong"
        aria-label="Fechar menu"
        data-menu-close
      >
        <Icon name="close" size={20} />
      </button>
    </div>
    <div class="ruler mt-6 h-3" aria-hidden="true"></div>
    <nav aria-label="Navegação mobile" class="mt-4 flex-1 overflow-y-auto">
      <ul>
        {navItems.map((item) => (
          <li class="border-b border-line">
            <a
              href={href(item.href)}
              data-nav-link
              data-menu-link
              class="flex items-center justify-between py-4 text-[1.6rem] font-medium tracking-[-0.03em] text-heading transition-colors hover:text-accent-text aria-[current=true]:text-accent-text"
            >
              {item.label}
              <Icon name="arrowUpRight" size={18} class="text-muted" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Button
      href={whatsappLink()}
      external
      size="lg"
      arrow
      class="w-full justify-between"
      data-track-location="menu"
    >
      Fale no WhatsApp
    </Button>
  </div>
</div>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: #0a6cff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='true']::after {
    transform: scaleX(1);
  }
  /* A onda do ícone "rever a intro" balança de leve no hover */
  .intro-replay-wave {
    transition: transform 500ms var(--ease-out-expo);
  }
  .intro-replay:hover .intro-replay-wave {
    transform: translateX(-1.5px);
  }
  .mobile-menu:not([hidden]) .menu-panel {
    animation: slide-in 420ms var(--ease-out-expo);
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
</style>
