---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import type { IconName } from './ui/icons';
import { navItems } from '@/config/navigation';
import { site, whatsappLink } from '@/config/site';

interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const href = (anchor: string) => (isHome ? anchor : `/${anchor}`);
const year = new Date().getFullYear();

const socials = (
  [
    ['instagram', 'Instagram', site.social.instagram],
    ['linkedin', 'LinkedIn', site.social.linkedin],
    ['behance', 'Behance', site.social.behance],
    ['github', 'GitHub', site.social.github],
  ] as [IconName, string, string][]
).filter(([, , url]) => url);

const analyticsEnabled = Boolean(
  import.meta.env.PUBLIC_GA_ID || import.meta.env.PUBLIC_META_PIXEL_ID,
);
---

<footer class="relative border-t border-line bg-bg-2/60 pt-16 pb-28 sm:pb-12">
  <div class="container-site">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <Logo withSlogan href={isHome ? '#inicio' : '/'} />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-body">
          Sites e landing pages sob medida para negócios que querem crescer no digital.
        </p>
        {socials.length > 0 && (
          <ul class="mt-6 flex gap-2" aria-label="Redes sociais">
            {socials.map(([icon, label, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid h-10 w-10 place-items-center rounded-full border border-line text-body transition-all duration-300 hover:-translate-y-0.5 hover:border-line-strong hover:text-heading"
                  aria-label={`${label} da ${site.name}`}
                >
                  <Icon name={icon} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav aria-label="Links rápidos">
        <h2 class="eyebrow !text-[0.68rem]">Navegação</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={href(item.href)} class="text-body transition-colors hover:text-heading">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow !text-[0.68rem]">Serviços</h2>
        <ul class="mt-5 space-y-3 text-sm text-body">
          <li>Sites institucionais</li>
          <li>Landing pages</li>
          <li>E-commerce & catálogo</li>
          <li>SEO & performance</li>
          <li>Manutenção</li>
        </ul>
      </div>

      <div>
        <h2 class="eyebrow !text-[0.68rem]">Contato</h2>
        <ul class="mt-5 space-y-4 text-sm">
          <li>
            <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 text-body transition-colors hover:text-heading"
            >
              <WhatsAppIcon class="h-4 w-4 text-eyebrow" />
              {site.contact.whatsappDisplay}
            </a>
          </li>
          {site.contact.email && (
            <li>
              <a
                href={`mailto:${site.contact.email}`}
                class="inline-flex items-center gap-3 text-body transition-colors hover:text-heading"
              >
                <Icon name="mail" size={16} class="text-eyebrow" />
                {site.contact.email}
              </a>
            </li>
          )}
          <li class="inline-flex items-center gap-3 text-body">
            <Icon name="mapPin" size={16} class="text-eyebrow" />
            {site.contact.city}, {site.contact.state} · Atendemos todo o Brasil
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-line pt-8 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>
        © {year}
        {site.name}. Todos os direitos reservados.
        <span class="block sm:inline sm:pl-1">
          <span data-only="dark">{site.themeCopy.dark.footerNote}</span>
          <span data-only="light">{site.themeCopy.light.footerNote}</span>
        </span>
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href="/politica-de-privacidade" class="transition-colors hover:text-heading">
            Política de Privacidade
          </a>
        </li>
        {analyticsEnabled && (
          <li>
            <button
              type="button"
              data-cookie-settings
              class="cursor-pointer transition-colors hover:text-heading"
            >
              Preferências de cookies
            </button>
          </li>
        )}
      </ul>
    </div>
  </div>
</footer>
