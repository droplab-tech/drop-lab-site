---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import type { IconName } from './ui/icons';
import { navItems } from '@/config/navigation';
import { site, whatsappLink } from '@/config/site';
// Versão do site: vem do package.json (atualize lá a cada nova versão)
import { version } from '../../package.json';

interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const href = (anchor: string) => (isHome ? anchor : `/${anchor}`);
const year = new Date().getFullYear();

const socials = (
  [
    ['instagram', 'Instagram', site.social.instagram],
    ['linkedin', 'LinkedIn', site.social.linkedin],
    ['behance', 'Behance', site.social.behance],
    ['github', 'GitHub', site.social.github],
  ] as [IconName, string, string][]
).filter(([, , url]) => url);

const analyticsEnabled = Boolean(
  import.meta.env.PUBLIC_GA_ID || import.meta.env.PUBLIC_META_PIXEL_ID,
);

const heading = 'text-measure text-muted';
const link = 'text-body transition-colors hover:text-heading';
---

<footer class="relative bg-bg-2 pt-16 pb-28 sm:pb-12">
  <div class="container-site">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <Logo withSlogan href={isHome ? '#inicio' : '/'} />
        <p class="mt-6 max-w-xs text-[0.95rem] leading-relaxed text-body">
          Sites profissionais sob medida para negócios que querem ser escolhidos.
        </p>
        {socials.length > 0 && (
          <ul class="mt-6 flex gap-2" aria-label="Redes sociais">
            {socials.map(([icon, label, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid h-10 w-10 place-items-center rounded-[6px] border border-line text-body transition-colors duration-300 hover:border-line-strong hover:text-heading"
                  aria-label={`${label} da ${site.name}`}
                >
                  <Icon name={icon} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav aria-label="Links rápidos" class="lg:col-span-2 lg:col-start-6">
        <h2 class={heading}>Navegação</h2>
        <ul class="mt-5 space-y-3 text-[0.95rem]">
          {navItems.map((item) => (
            <li>
              <a href={href(item.href)} class={link}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <h2 class={heading}>Serviços</h2>
        <ul class="mt-5 space-y-3 text-[0.95rem] text-body">
          <li>Sites institucionais</li>
          <li>Landing pages</li>
          <li>E-commerce & catálogo</li>
          <li>SEO & performance</li>
          <li>Manutenção</li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class={heading}>Contato</h2>
        <ul class="mt-5 space-y-3 text-[0.95rem]">
          <li>
            <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener noreferrer"
              data-track-location="footer"
              class={link}
            >
              {site.contact.whatsappDisplay}
            </a>
          </li>
          {site.contact.email && (
            <li>
              <a href={`mailto:${site.contact.email}`} class:list={[link, 'break-all']}>
                {site.contact.email}
              </a>
            </li>
          )}
          <li class="text-body">
            {site.contact.city}, {site.contact.state} · Atendemos todo o Brasil
          </li>
        </ul>
      </div>
    </div>

    <div class="ruler mt-16 h-3" aria-hidden="true"></div>
    <div class="flex flex-col gap-4 pt-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>
        © {year}
        {site.name}. Todos os direitos reservados.
        <span class="block sm:inline sm:pl-1">
          <span data-only="dark">{site.themeCopy.dark.footerNote}</span>
          <span data-only="light">{site.themeCopy.light.footerNote}</span>
        </span>
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href="/politica-de-privacidade" class="transition-colors hover:text-heading">
            Política de Privacidade
          </a>
        </li>
        <li>
          <span class="font-mono text-xs tracking-[-0.02em] text-muted" title="Versão do site">
            v{version}
          </span>
        </li>
        {analyticsEnabled && (
          <li>
            <button
              type="button"
              data-cookie-settings
              class="cursor-pointer transition-colors hover:text-heading"
            >
              Preferências de cookies
            </button>
          </li>
        )}
      </ul>
    </div>
  </div>
</footer>
