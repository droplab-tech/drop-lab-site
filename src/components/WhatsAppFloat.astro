---
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { whatsappLink } from '@/config/site';
---

<!--
  Botão flutuante do WhatsApp. Aparece depois de rolar um pouco (não cobre o Hero)
  e respeita a área segura do iPhone. Tamanho de 56px para toque confortável.
-->
<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Fale conosco pelo WhatsApp (abre em nova aba)"
  data-wa-float
  class="wa-float group fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_12px_30px_-8px_rgb(0_0_0/0.6)] transition-all duration-300 hover:scale-105 sm:right-6 sm:bottom-6"
>
  <WhatsAppIcon class="relative h-7 w-7" />
  <span
    class="pointer-events-none absolute right-full mr-3 rounded-[6px] bg-surface px-3 py-1.5 text-sm font-medium whitespace-nowrap text-heading opacity-0 shadow-lg ring-1 ring-line transition-all duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
    aria-hidden="true"
  >
    Fale conosco
  </span>
</a>

<style>
  .wa-float {
    opacity: 0;
    visibility: hidden; /* fora da ordem de foco enquanto escondido */
    transform: translateY(16px) scale(0.9);
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      visibility 300ms,
      scale 200ms ease;
  }
  .wa-float[data-visible='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* Sem JS, o botão aparece sempre */
  :global(html:not(.js)) .wa-float {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
</style>
