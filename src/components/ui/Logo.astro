---
import LogoMark from './LogoMark.astro';
import { site } from '@/config/site';

interface Props {
  class?: string;
  /** Mostra o slogan abaixo do nome */
  withSlogan?: boolean;
  href?: string;
}
const { class: className = '', withSlogan = false, href = '/' } = Astro.props;
---

<a href={href} class:list={['group inline-flex items-center gap-3 rounded-lg', className]}>
  <span class="sr-only">Página inicial da </span>
  <LogoMark class="h-9 w-9 shrink-0 transition-transform duration-300 group-hover:scale-105" />
  <span class="flex flex-col leading-none whitespace-nowrap">
    <!-- Wordmark: "Drop" na cor do título (branco no escuro), "lab" em degradê azul -->
    <span class="font-display text-[1.45rem] font-bold tracking-tight text-heading">
      Drop<span class="text-gradient">lab</span>
    </span>
    {withSlogan && (
      <span class="mt-1.5 font-display text-[0.6rem] font-medium tracking-[0.3em] text-muted uppercase">
        {site.slogan}
      </span>
    )}
  </span>
</a>
