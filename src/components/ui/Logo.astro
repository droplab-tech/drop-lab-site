---
import LogoMark from './LogoMark.astro';
import { site } from '@/config/site';

interface Props {
  class?: string;
  /** Mostra o slogan abaixo do nome */
  withSlogan?: boolean;
  href?: string;
}
const { class: className = '', withSlogan = false, href = '/' } = Astro.props;
---

<a href={href} class:list={['group inline-flex items-center gap-2.5 rounded-md', className]}>
  <span class="sr-only">Página inicial da </span>
  <LogoMark class="h-8 w-8 shrink-0" />
  <span class="flex flex-col leading-none whitespace-nowrap">
    <span class="text-[1.3rem] font-semibold tracking-[-0.04em] text-heading">
      Drop<span class="text-brand dark:text-[#2f86ff]">lab</span>
    </span>
    {withSlogan && (
      <span class="mt-2 text-measure text-[0.6rem]! text-muted">{site.slogan}</span>
    )}
  </span>
</a>
