---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'light';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  /** Renderiza <button> em vez de <a> */
  as?: 'a' | 'button';
  type?: 'button' | 'submit';
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  as = href ? 'a' : 'button',
  type = 'button',
  external = false,
  ...rest
} = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-2 rounded-full font-display font-semibold whitespace-nowrap transition-all duration-300 ease-out-soft focus-visible:outline-offset-4 disabled:pointer-events-none disabled:opacity-60';

const sizes: Record<Size, string> = {
  sm: 'h-10 px-4 text-sm',
  md: 'h-12 px-6 text-[0.95rem]',
  lg: 'h-14 px-7 text-base',
};

const variants: Record<Variant, string> = {
  // Degradê da marca + brilho no hover
  primary:
    'bg-button-gradient text-white shadow-[0_0_0_1px_rgb(34_211_238/0.35)_inset,0_10px_30px_-10px_rgb(10_108_255/0.7)] hover:-translate-y-0.5 hover:shadow-[0_0_0_1px_rgb(34_211_238/0.6)_inset,0_14px_40px_-8px_rgb(10_108_255/0.9)]',
  secondary:
    'glass text-heading hover:-translate-y-0.5 hover:border-line-strong hover:shadow-[0_10px_30px_-12px_var(--glow)]',
  ghost: 'text-heading hover:text-eyebrow',
  light:
    'bg-white text-ink shadow-[0_10px_30px_-10px_rgb(0_0_0/0.5)] hover:-translate-y-0.5 hover:shadow-[0_16px_40px_-10px_rgb(0_0_0/0.6)]',
};

const classes = [base, sizes[size], variants[variant], className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{as === 'a' ? (
  <a href={href} class:list={classes} {...externalAttrs} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <slot />
  </button>
)}
