---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  strokeWidth?: number;
  /** Rótulo acessível. Sem ele, o ícone é decorativo (aria-hidden). */
  label?: string;
}

const { name, class: className = '', size = 24, strokeWidth = 1.75, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
