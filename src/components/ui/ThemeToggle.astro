---
/**
 * Botão de tema: um quadrado com sol/lua. O nome acessível muda com o tema.
 * Lógica em src/scripts/theme.ts
 */
import Icon from './Icon.astro';
import { site } from '@/config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    'grid h-10 w-10 shrink-0 place-items-center rounded-[6px] border border-line text-body transition-colors duration-300 hover:border-line-strong hover:text-heading',
    className,
  ]}
>
  <span class="sr-only" data-only="dark">
    {site.themeCopy.dark.toggleLabel}
  </span>
  <span class="sr-only" data-only="light">
    {site.themeCopy.light.toggleLabel}
  </span>
  <span data-only="dark">
    <Icon name="sun" size={17} strokeWidth={1.75} />
  </span>
  <span data-only="light">
    <Icon name="moon" size={17} strokeWidth={1.75} />
  </span>
</button>
