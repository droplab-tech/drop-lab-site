---
/**
 * A gota da marca como objeto de cena: iluminada pela luz fria vinda
 * do alto à direita, com brilho de borda e reflexo no chão.
 */
interface Props {
  class?: string;
  /** Desenha o reflexo invertido abaixo */
  reflection?: boolean;
}
const { class: className = '', reflection = true } = Astro.props;
const uid = `ld${Math.random().toString(36).slice(2, 8)}`;
const d = 'M100 4C136 50 196 124 196 164a96 96 0 0 1-192 0C4 124 64 50 100 4Z';
---

<div class:list={['relative', className]} aria-hidden="true">
  <svg viewBox="0 0 200 264" class="relative z-10 block h-full w-auto overflow-visible">
    <defs>
      <linearGradient
        id={`${uid}body`}
        x1="40"
        y1="20"
        x2="150"
        y2="264"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#4fdcf2"></stop>
        <stop offset=".38" stop-color="#0a6cff"></stop>
        <stop offset=".78" stop-color="#0a2f86"></stop>
        <stop offset="1" stop-color="#071636"></stop>
      </linearGradient>
      <radialGradient id={`${uid}key`} cx="150" cy="110" r="120" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#9df0ff" stop-opacity=".75"></stop>
        <stop offset=".45" stop-color="#22d3ee" stop-opacity=".18"></stop>
        <stop offset="1" stop-color="#22d3ee" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id={`${uid}core`} cx="70" cy="210" r="110" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#030712" stop-opacity=".7"></stop>
        <stop offset="1" stop-color="#030712" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient
        id={`${uid}rim`}
        x1="190"
        y1="60"
        x2="40"
        y2="250"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#ffffff" stop-opacity="1"></stop>
        <stop offset=".4" stop-color="#9df0ff" stop-opacity=".55"></stop>
        <stop offset=".7" stop-color="#9df0ff" stop-opacity="0"></stop>
      </linearGradient>
      <filter id={`${uid}soft`} x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="7"></feGaussianBlur>
      </filter>
    </defs>
    <path d={d} fill={`url(#${uid}body)`}></path>
    <path d={d} fill={`url(#${uid}core)`}></path>
    <path d={d} fill={`url(#${uid}key)`}></path>
    <path d={d} fill="none" stroke={`url(#${uid}rim)`} stroke-width="2"></path>
    <!-- Brilho suave do lado da luz (alto à direita) -->
    <ellipse
      cx="146"
      cy="118"
      rx="16"
      ry="34"
      transform="rotate(-28 146 118)"
      fill="#e9fdff"
      fill-opacity=".55"
      filter={`url(#${uid}soft)`}
      class="glint"
    ></ellipse>
    <ellipse
      cx="62"
      cy="196"
      rx="10"
      ry="22"
      transform="rotate(20 62 196)"
      fill="#9df0ff"
      fill-opacity=".14"
      filter={`url(#${uid}soft)`}
    ></ellipse>
  </svg>
  {reflection && (
    <svg
      viewBox="0 0 200 264"
      class="reflection absolute top-full left-0 block h-full w-auto -scale-y-100 opacity-30"
    >
      <path d={d} fill="#0a6cff"></path>
    </svg>
  )}
</div>

<style>
  :global(.motion) .glint {
    animation: glint 7s ease-in-out infinite;
  }
  @keyframes glint {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  .reflection {
    mask-image: linear-gradient(to top, #000 0%, transparent 38%);
    filter: blur(3px);
  }
</style>
