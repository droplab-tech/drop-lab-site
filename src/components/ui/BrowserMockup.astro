---
/**
 * Mockup ilustrativo de um site em uma janela de navegador (só CSS + SVG).
 * Usado no Hero e na seção "O que você recebe". É decorativo (aria-hidden).
 */
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';

interface Props {
  class?: string;
  /** Gota flutuando (animação). Use só em um lugar visível por vez, por performance. */
  animated?: boolean;
}
const { class: className = '', animated = false } = Astro.props;
---

<!-- Janela do navegador (o brilho vem de um box-shadow, mais leve que um elemento animado) -->
<div
  class:list={[
    'glass relative overflow-hidden rounded-2xl shadow-[0_0_120px_-10px_var(--glow)]!',
    className,
  ]}
  aria-hidden="true"
>
  <div class="flex items-center gap-2 border-b border-line px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
    <div class="ml-3 flex h-6 flex-1 items-center gap-2 rounded-md bg-bg/60 px-3 text-[0.7rem] text-muted">
      <Icon name="shield" size={11} strokeWidth={2} />
      seunegocio.com.br
    </div>
  </div>
  <div class="relative p-6 sm:p-8">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="h-5 w-5 rounded-md bg-button-gradient"></span>
        <span class="h-2 w-16 rounded-full bg-heading/70"></span>
      </div>
      <div class="hidden gap-3 sm:flex">
        <span class="h-1.5 w-8 rounded-full bg-line-strong"></span>
        <span class="h-1.5 w-8 rounded-full bg-line-strong"></span>
        <span class="h-1.5 w-8 rounded-full bg-line-strong"></span>
      </div>
    </div>
    <div class="mt-9 grid grid-cols-[1.3fr_1fr] items-center gap-6">
      <div>
        <span class="block h-3.5 w-full rounded-full bg-heading/85"></span>
        <span class="mt-2.5 block h-3.5 w-4/5 rounded-full bg-heading/85"></span>
        <span class="mt-5 block h-2 w-full rounded-full bg-line-strong"></span>
        <span class="mt-2 block h-2 w-3/4 rounded-full bg-line-strong"></span>
        <span class="mt-6 inline-flex h-8 w-28 items-center justify-center rounded-full bg-button-gradient shadow-[0_8px_20px_-6px_rgb(10_108_255/0.7)]">
          <span class="h-1.5 w-14 rounded-full bg-white/90"></span>
        </span>
      </div>
      <div class="relative grid aspect-square place-items-center">
        <div class="absolute inset-[12%] rounded-full bg-[radial-gradient(closest-side,rgb(34_211_238/0.45),transparent)]"></div>
        <LogoMark class:list={['relative h-full w-full', animated && 'animate-float']} />
      </div>
    </div>
    <div class="mt-8 grid grid-cols-3 gap-3">
      {['zap', 'gauge', 'target'].map((icon) => (
        <div class="rounded-xl border border-line bg-bg/40 p-3">
          <Icon name={icon as 'zap'} size={16} class="text-eyebrow" />
          <span class="mt-2.5 block h-1.5 w-3/4 rounded-full bg-heading/60" />
          <span class="mt-1.5 block h-1.5 w-1/2 rounded-full bg-line-strong" />
        </div>
      ))}
    </div>
  </div>
</div>
