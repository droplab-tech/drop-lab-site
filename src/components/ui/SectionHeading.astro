---
/**
 * Título de seção: título grande à esquerda, texto de apoio à direita,
 * alinhado pela base. Sem rótulo acima do título.
 */
interface Props {
  id: string;
  title: string;
  description?: string;
  class?: string;
}
const { id, title, description, class: className = '' } = Astro.props;
---

<header
  class:list={['mb-14 grid gap-6 sm:mb-20 lg:grid-cols-12 lg:items-end lg:gap-10', className]}
  data-reveal
>
  <h2 id={id} class="text-title lg:col-span-7">
    {title}
  </h2>
  {description && (
    <p class="max-w-md text-[1.0625rem] leading-relaxed text-body lg:col-span-4 lg:col-start-9">
      {description}
    </p>
  )}
  <slot />
</header>
