---
import Drop from './Drop.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  /** Trecho do título destacado em degradê */
  highlight?: string;
  description?: string;
  align?: 'center' | 'left';
}
const { id, eyebrow, title, highlight, description, align = 'center' } = Astro.props;
---

<header
  class:list={['mb-14 max-w-3xl', align === 'center' ? 'mx-auto text-center' : 'text-left']}
  data-reveal
>
  <p
    class:list={[
      'eyebrow inline-flex items-center gap-2.5',
      align === 'center' && 'justify-center',
    ]}
  >
    <Drop class="h-3 w-2.5" />
    {eyebrow}
  </p>
  <h2 id={id} class="mt-4 text-3xl leading-tight sm:text-4xl lg:text-[2.75rem]">
    {title}
    {highlight && <span class="text-gradient">{highlight}</span>}
  </h2>
  {description && <p class="mt-5 text-lg leading-relaxed text-body">{description}</p>}
</header>
