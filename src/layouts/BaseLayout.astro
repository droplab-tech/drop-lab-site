---
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '@/styles/global.css';
import soraWoff2 from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  /** Caminho da imagem OG (em /public) */
  image?: string;
  isHome?: boolean;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  isHome = false,
  noindex = false,
} = Astro.props;

// URLs absolutas só existem quando o domínio estiver preenchido em site.ts.
// Sem domínio, canonical / og:url / og:image / twitter:image não são gerados.
const siteUrl = site.url;
const canonical = siteUrl
  ? new URL(
      // build.format 'file' gera /index.html e /pagina.html: o canonical usa a URL limpa
      Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/',
      siteUrl,
    ).href
  : undefined;
const ogImage = siteUrl ? new URL(image, siteUrl).href : undefined;

// Dados estruturados (JSON-LD) para o Google.
// Os campos que dependem do domínio só entram quando ele existir.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#business`,
      name: site.name,
      alternateName: `${site.name} | ${site.slogan}`,
      description: site.description,
      ...(siteUrl && {
        url: siteUrl,
        logo: `${siteUrl}/icon-512.png`,
        image: ogImage,
      }),
      telephone: `+${site.contact.whatsapp}`,
      ...(site.contact.email && { email: site.contact.email }),
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.contact.city,
        addressRegion: site.contact.state,
        addressCountry: site.contact.country,
      },
      areaServed: { '@type': 'Country', name: site.contact.areaServed },
      knowsAbout: ['Criação de sites', 'Landing pages', 'SEO', 'E-commerce', 'Desenvolvimento web'],
      sameAs: Object.values(site.social).filter(Boolean),
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: `+${site.contact.whatsapp}`,
        contactType: 'sales',
        availableLanguage: 'Portuguese',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      ...(siteUrl && { url: siteUrl }),
      name: site.name,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${siteUrl}/#business` },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Tema: aplicado antes da pintura para evitar "piscar" -->
    <script is:inline define:vars={{ defaultTheme: site.defaultTheme }}>
      (function () {
        const d = document.documentElement;
        let t = defaultTheme;
        try {
          t = localStorage.getItem('droplab-theme') || defaultTheme;
        } catch {
          /* localStorage indisponível: usa o tema padrão */
        }
        if (t === 'system') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        d.dataset.theme = t;
        d.classList.add('js');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#05070D" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F5F8FD" media="(prefers-color-scheme: light)" />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />

    <!-- Fontes principais com preload (auto-hospedadas, font-display: swap) -->
    <link rel="preload" href={soraWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${site.name}: ${site.slogan}`} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#conteudo"
      class="fixed top-3 left-3 z-[100] -translate-y-24 rounded-full bg-brand px-5 py-3 font-display text-sm font-semibold text-white shadow-lg transition-transform focus:translate-y-0"
    >
      Pular para o conteúdo
    </a>

    <!-- Gradiente compartilhado pelas "gotas" decorativas (Drop.astro) -->
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="drop-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#22D3EE"></stop>
          <stop offset="1" stop-color="#0A6CFF"></stop>
        </linearGradient>
      </defs>
    </svg>

    <Header isHome={isHome} />
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer isHome={isHome} />
    <WhatsAppFloat />
    <CookieBanner />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
