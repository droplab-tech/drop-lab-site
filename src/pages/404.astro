---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { whatsappLink } from '@/config/site';
---

<BaseLayout
  title="Página não encontrada | DropLab"
  description="A página que você procura não existe ou foi movida."
  noindex
>
  <section
    class="relative isolate flex min-h-[85vh] items-center overflow-hidden pt-28 pb-20"
    aria-labelledby="erro-title"
  >
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="beam light-on"></div>
    </div>

    <div class="container-site text-center">
      <!-- Gota "caindo" no lugar do zero -->
      <p
        class="flex items-center justify-center gap-2 text-[7rem] leading-none font-medium tracking-[-0.06em] text-heading sm:text-[10rem]"
        aria-hidden="true"
      >
        <span>4</span>
        <svg viewBox="0 0 20 26" class="h-[0.8em] w-[0.62em]">
          <path
            d="M10 0c3.4 4.4 10 12.5 10 16a10 10 0 0 1-20 0C0 12.5 6.6 4.4 10 0Z"
            fill="url(#drop-gradient)"
          ></path>
        </svg>
        <span>4</span>
      </p>
      <h1 id="erro-title" class="mt-6 text-title">
        Essa página evaporou
      </h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-body">
        O link pode estar quebrado ou a página foi movida. Mas fica tranquilo: o caminho de volta é
        rápido.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href="/" size="lg">
          Voltar ao início
        </Button>
        <Button href={whatsappLink()} external size="lg" variant="secondary" arrow>
          Falar no WhatsApp
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
