# Copie para .env (local) ou configure no painel da Vercel/Netlify.
# Todas são opcionais: se ficarem vazias, o recurso permanece desligado.

# Google Analytics 4 (ex.: G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Meta Pixel (ex.: 123456789012345)
PUBLIC_META_PIXEL_ID=

# Envio do formulário também por e-mail — escolha UM dos dois:
# Web3Forms: https://web3forms.com (chave de acesso gratuita)
PUBLIC_WEB3FORMS_KEY=
# Formspree: https://formspree.io (ID do formulário, ex.: xyzabcd)
PUBLIC_FORMSPREE_ID=
